{
  "name": "kapow-castle",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"node --watch server/index.js\" \"vite client\"",
    "build": "vite build client --outDir ../dist --emptyOutDir",
    "start": "node server/index.js",
    "ship": "flyctl deploy -a kapow-castle --ha=false --remote-only --yes",
    "setup:vapi": "node scripts/setup-vapi.mjs"
  },
  "dependencies": {
    "@vapi-ai/web": "^2.5.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.0.7"
  }
}
